{
  "name": "hackutd-coordinator-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "app": "node scripts/app-dev.mjs",
    "app:start": "npm run build && electron .",
    "app:pack": "node scripts/stamp-repo.mjs && npm run build && electron-builder --mac dir",
    "app:dmg": "node scripts/stamp-repo.mjs && npm run build && electron-builder --mac dmg",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spacetimedb": "2.14.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.1",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs",
  "productName": "UnderDog",
  "description": "UnderDog coordinator dashboard (desktop app)",
  "build": {
    "appId": "com.hackutd.underdog",
    "productName": "UnderDog",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/icon.png",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}
