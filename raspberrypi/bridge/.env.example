# Robot bridge settings. Copy to .env (git-ignored) and edit. Never commit a token.
# Values below are for a laptop run with the C++ program in laptop mode (robot.md 3.4).
# On the Pi, /etc/robot/bridge.env uses the commented values (robot.md 9.2).

# SpacetimeDB server: ws://localhost:3000 for the local fallback, https://maincloud.spacetimedb.com for Maincloud.
STDB_URI=ws://localhost:3000
STDB_DATABASE=assess-0hw81
# Optional: use this token instead of the token file (nothing is written to disk then).
STDB_TOKEN=
# sdk (default) or http. http is a documented test switch (robot.md 9.10) that is not implemented; it falls back to sdk.
STDB_MODE=sdk

# Must equal the C++ config robot.robot_id; it is also the participant name.
ROBOT_ID=dog1

# Unix socket the C++ program connects to. Pi: /run/robot/bridge.sock
BRIDGE_SOCKET=/tmp/robot-bridge.sock

# Media server (part of the perception service). Pi: the laptop's address on the field network.
MEDIA_URL=http://localhost:8080

# The robot's identity. The server host is appended, one file per server, for example
# ./.data/token.localhost_3000 and ./.data/token.maincloud.spacetimedb.com (mode 0600).
# Pi: /var/lib/robot/bridge/token
BRIDGE_TOKEN_FILE=./.data/token

# Spool for messages while SpacetimeDB is unreachable. Pi: /var/lib/robot/bridge/spool.jsonl
SPOOL_FILE=./.data/spool.jsonl
SPOOL_MAX_MB=50

# Upload attempts in all per file (waits 1, 2, 4, 8 s between them).
MEDIA_RETRIES=5

# How often to try claim_next_mission while the robot is READY with no mission.
CLAIM_INTERVAL_MS=2000

# Optional camera terrain hint (robot.md 7b.5, 9.4): off unless the robot's terrain.camera_hint.enabled
# is true too. MEDIA_DIR must be the robot's media_dir. Pi: /var/lib/robot/media
TERRAIN_HINT=off
MEDIA_DIR=/tmp/robot/media
# The robot's terrain.camera_hint.max_age_ms: frames and answers older than this are not sent.
TERRAIN_HINT_MAX_AGE_MS=1500
